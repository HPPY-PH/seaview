{
  "name": "Booking",
  "type": "object",
  "properties": {
    "sv_number": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_user_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "airbnb",
        "vrbo",
        "direct"
      ],
      "default": "direct"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_house",
        "completed",
        "cancelled",
        "archived"
      ],
      "default": "pending"
    },
    "num_guests": {
      "type": "number",
      "default": 1
    },
    "num_nights": {
      "type": "number",
      "default": 1
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "notes": {
      "type": "string"
    },
    "provider_event_id": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "auto",
        "needs_review",
        "resolved"
      ],
      "default": "auto"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "sv_number",
    "guest_id",
    "source",
    "check_in",
    "check_out",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.guest_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}