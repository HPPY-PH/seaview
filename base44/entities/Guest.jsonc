{
  "name": "Guest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blacklisted"
      ],
      "default": "active"
    },
    "user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "invited": {
      "type": "boolean",
      "default": false
    },
    "invite_status": {
      "type": "string",
      "enum": [
        "not_invited",
        "pending",
        "accepted",
        "revoked"
      ],
      "default": "not_invited"
    },
    "total_stays": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_checkin_notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}