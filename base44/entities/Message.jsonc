{
  "name": "Message",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string"
    },
    "guest_user_id": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "outbound"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "sms",
        "portal"
      ],
      "default": "portal"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "read",
        "failed"
      ],
      "default": "sent"
    }
  },
  "required": [
    "guest_id",
    "body",
    "direction"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.guest_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}